# SMY Agent configuration — copy to .env (local) or set in cPanel "Setup Python App".
# Never put real values in this file.

APP_ENV=development              # development | test | production
APP_NAME=SMY Agent
APP_SECRET_KEY=                  # required in production, 32+ random chars
APP_BASE_URL=http://localhost:8000

DATABASE_URL=sqlite:///./smy_agent.db   # production: mysql+pymysql://user:pass@localhost/dbname?charset=utf8mb4

AI_PROVIDER=                     # e.g. anthropic (empty = AI features disabled)
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_LARGE=

SEARCH_PROVIDER=                 # e.g. 2gis, google_places (empty = manual entry only)
SEARCH_API_KEY=

TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=              # comma-separated numeric Telegram user IDs

OUTBOUND_SENDING_ENABLED=false
LOG_LEVEL=INFO
DAILY_AI_BUDGET_USD=0
DAILY_SEARCH_LIMIT=0
DEFAULT_TIMEZONE=Asia/Tashkent
