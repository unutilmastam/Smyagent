# SMY Agent configuration — copy to .env (local) or set in cPanel "Setup Python App".
# Never put real values in this file. Comments are on their own lines so values
# can be copied into the cPanel UI as-is.

# development | test | production
APP_ENV=development
APP_NAME=SMY Agent
# Required in production: 32+ random characters.
APP_SECRET_KEY=
# Production: must start with https://
APP_BASE_URL=http://localhost:8000

# Production example: mysql+pymysql://user:pass@localhost/dbname?charset=utf8mb4
DATABASE_URL=sqlite:///./smy_agent.db

# e.g. anthropic (empty = AI features disabled)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_LARGE=

# osm = OpenStreetMap (free, no key, default); empty = automatic discovery off.
# Later: google_places / 2gis with SEARCH_API_KEY.
SEARCH_PROVIDER=osm
SEARCH_API_KEY=

# Owner control bot token from @BotFather (M3c)
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_TOKEN=
# Random 32+ chars of A-Z a-z 0-9 _ - ; Telegram sends it back in a header on every update
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs (not usernames)
TELEGRAM_ADMIN_IDS=

OUTBOUND_SENDING_ENABLED=false

# Outbound email (M9): a cPanel mailbox on your domain, e.g. agent@itcode.uz.
# Set SPF/DKIM/DMARC first (docs/deployment-cpanel.md). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
# e.g. Mustafo — ITcoDe.Uz <agent@itcode.uz>
SMTP_FROM=
# Same mailbox over IMAP (replies, STOP, bounces). Empty = replies are read by you only.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
LOG_LEVEL=INFO
# Hard monthly AI budget in USD (ADR-0007: target <= 10). 0 = no AI spending allowed.
MONTHLY_AI_BUDGET_USD=10
# 0 = automatic (monthly budget / days in month); set a number for a stricter daily cap.
DAILY_AI_BUDGET_USD=0
# 0 = no paid search requests allowed
DAILY_SEARCH_LIMIT=0
DEFAULT_TIMEZONE=Asia/Tashkent
